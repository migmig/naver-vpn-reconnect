#!/bin/bash
#
# naver-vpn-up — NAVER VPN 재연결용 root 래퍼 (프로젝트가 자동 설치)
#
# 이 파일은 root 소유로 /usr/local/sbin 에 설치되고, /etc/sudoers.d/naver-vpn 에서
# NOPASSWD 권한을 받는다. 하는 일은 딱 두 가지뿐:
#   1) 기존 NAVER openvpn 세션 종료
#   2) (사용자 프로필 디렉토리의) 지정 .ovpn + 인증파일로 openvpn 실행
#
# 인자:
#   $1 = 프로필 파일명 (basename, 예: vpn2033.ovpn — 슬래시/공백 불가)
#   $2 = 인증파일 경로 (/tmp/naver-vpn-auth.* )
#
# 프로필 디렉토리는 일반 사용자가 쓰기 가능하므로, .ovpn 내용을 검증해
# root 코드 실행을 유발하는 지시어(up/plugin/script-security 등)가 든 설정을
# 거부한다. 검증은 root 소유 임시 복사본에 수행해 검사-실행 사이
# 바꿔치기(TOCTOU)도 막는다. 이 검증이 없으면 NOPASSWD 가 곧 root 셸이 된다.
# 절대 직접 수정하지 말 것 — 'make install' 로 재생성된다 (@HOME@ 치환).
#
set -eu

NAME="${1:-}"
AUTH="${2:-}"
OVPN="/Applications/NAVER Cloud SSL VPN.app/Contents/vpn/openvpn"
PROFDIR="@HOME@/Library/Application Support/ncurion-sa-client/vpn/profiles"
LOG="@HOME@/Library/Application Support/ncurion-sa-client/vpn/vpn.log"

# 프로필 파일명 검증: 슬래시 없음 + .ovpn 으로 끝남
case "$NAME" in
  */*|"") echo "naver-vpn-up: invalid profile name" >&2; exit 1 ;;
  *.ovpn) ;;
  *) echo "naver-vpn-up: profile must end with .ovpn" >&2; exit 1 ;;
esac
# 인증파일은 스크립트가 만든 임시파일이어야 함
case "$AUTH" in
  /tmp/naver-vpn-auth.*) ;;
  *) echo "naver-vpn-up: invalid auth path" >&2; exit 1 ;;
esac

CONFIG="$PROFDIR/$NAME"
[ -f "$CONFIG" ] || { echo "naver-vpn-up: config not found: $CONFIG" >&2; exit 1; }
[ -f "$AUTH" ]   || { echo "naver-vpn-up: auth file not found" >&2; exit 1; }
[ -x "$OVPN" ]   || { echo "naver-vpn-up: openvpn not found" >&2; exit 1; }

# 로그 파일은 일반 사용자가 읽을 수 있어야 한다 — 클라이언트가 이 로그로 연결 성공을
# 판정하고 keepalive 가 게이트웨이를 찾는다. 파일이 없을 때 root(openvpn) 가 만들면
# root 소유 0600 이 되어 터널은 붙었는데 "연결 실패" 로 보이므로, 미리 사용자 소유로 만든다.
LOGDIR="$(dirname "$LOG")"
[ -d "$LOGDIR" ] || { echo "naver-vpn-up: log dir not found: $LOGDIR" >&2; exit 1; }
[ -L "$LOG" ] && { echo "naver-vpn-up: log path is a symlink, refusing" >&2; exit 1; }
[ -e "$LOG" ] || : > "$LOG"
chown "$(stat -f '%u:%g' "$LOGDIR")" "$LOG"
chmod 644 "$LOG"

# root 소유 임시 복사본 생성(/tmp 는 sticky — 일반 사용자가 못 건드림) 후
# 외부 프로그램 실행을 유발하는 지시어가 있으면 거부. openvpn 도 이 복사본으로 실행.
SAFE="$(mktemp /tmp/naver-vpn-conf.XXXXXX)"
trap 'rm -f "$SAFE"' EXIT
cat "$CONFIG" > "$SAFE"
# management 는 NAVER 정식 프로필이 쓰는 지시어(로컬 제어 채널)라 차단하지 않는다.
BAD='^[[:space:]]*(script-security|up|down|route-up|route-pre-down|ipchange|iproute|client-connect|client-disconnect|learn-address|auth-user-pass-verify|tls-verify|plugin|config)([[:space:]]|$)'
if LC_ALL=C grep -Eq "$BAD" "$SAFE"; then
  echo "naver-vpn-up: profile contains a forbidden directive (would execute code as root)" >&2
  exit 1
fi

pkill -f 'vpn/openvpn' 2>/dev/null || true
sleep 1
# --daemon 은 설정을 다 읽은 뒤 분기하므로, 리턴 후 임시 복사본을 지워도 안전하다.
"$OVPN" --config "$SAFE" --auth-user-pass "$AUTH" --auth-nocache --daemon --log "$LOG"
