#!/bin/bash
#
# naver-vpn — NAVER Cloud SSL VPN 재연결 클라이언트
#
# 설정파일($HOME/.config/naver-vpn/config)의 값과 키체인에 저장된 비밀번호로
#   1) /api/v3/authstate 호출 → 비번 검증 + OTP 문자 발송 + 프로필(.ovpn) 수신
#   2) 문자로 받은 OTP 입력
#   3) (root 래퍼 경유) openvpn 으로 연결
# 까지 자동화한다. 설정은 `make setup` 으로 만든다.
#
# 사용법:
#   naver-vpn          # 문자 발송 후 OTP를 물어봄
#   naver-vpn 123456   # OTP를 인자로 바로 전달
#
set -euo pipefail

# ---- 색/프레임 헬퍼 (TTY·NO_COLOR 인지) ----
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'; C_RED=$'\033[31m'
  C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_CYAN=$'\033[36m'
else C_RESET=; C_BOLD=; C_DIM=; C_RED=; C_GREEN=; C_YELLOW=; C_CYAN=; fi
ftop(){ printf '\n%s╭─%s %s📡 %s%s %s──────────────%s\n' "$C_DIM" "$C_RESET" "$C_BOLD$C_CYAN" "$1" "$C_RESET" "$C_DIM" "$C_RESET"; }
fbot(){ printf '%s╰──────────────────────────────────────────────%s\n\n' "$C_DIM" "$C_RESET"; }
line(){ printf '%s│%s  %s\n' "$C_DIM" "$C_RESET" "$*"; }
dim(){  printf '%s%s%s' "$C_DIM" "$1" "$C_RESET"; }
errm(){ printf '%s❌ %s%s\n' "$C_RED" "$*" "$C_RESET"; }

CONF="${NAVER_VPN_CONFIG:-$HOME/.config/naver-vpn/config}"
if [ ! -f "$CONF" ]; then
  errm "설정이 없습니다: $CONF"
  printf '   %s프로젝트 디렉토리에서 '\''make setup'\'' 을 먼저 실행하세요.%s\n' "$C_DIM" "$C_RESET"
  exit 1
fi
# shellcheck disable=SC1090
. "$CONF"

: "${VPN_USER:?VPN_USER 가 설정파일에 없습니다 (make setup)}"
DOMAIN="${DOMAIN:-https://sslvpn-kr-vpc-01.gov-ncloud.com:8443}"
OVPN_NAME="${OVPN_NAME:-vpn2033.ovpn}"
CLIENT_VERSION="${CLIENT_VERSION:-1.1.3}"
KC_SERVICE="${KC_SERVICE:-naver-vpn}"
TARGET="${TARGET:-}"   # (선택) 추가 확인용 IP. 비우면 자동 감지만 사용

OVPN_BIN="/Applications/NAVER Cloud SSL VPN.app/Contents/vpn/openvpn"
DATADIR="$HOME/Library/Application Support/ncurion-sa-client/vpn"
LOG="$DATADIR/vpn.log"
WRAPPER="/usr/local/sbin/naver-vpn-up"

# 터널(utun*)에 할당된 사설 IPv4 목록 (사람마다 다름 — 자동 감지)
tunnel_ips(){
  ifconfig 2>/dev/null | awk '
    /^utun[0-9]/{u=1; next} /^[a-z]/{u=0}
    u && /inet /{ if ($2 ~ /^(10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.)/) print $2 }'
}
# 첫 번째 사설 터널 IP
tunnel_ip(){ tunnel_ips | head -1; }
# 터널 게이트웨이 (openvpn 이 push 한 route 의 게이트웨이; 실패 시 .1 추정)
tunnel_gw(){
  local ip="$1" gw
  gw="$(awk '/route add -net/{for(i=1;i<=NF;i++) if($i=="-net"){print $(i+2); break}}' "$LOG" 2>/dev/null \
        | grep -E '^(10\.|172\.|192\.168\.)' | grep -v -x "$ip" | head -1)"
  [ -z "$gw" ] && [ -n "$ip" ] && gw="${ip%.*}.1"
  echo "$gw"
}

command -v jq   >/dev/null 2>&1 || { errm "jq 가 필요합니다: brew install jq"; exit 1; }
command -v curl >/dev/null 2>&1 || { errm "curl 이 필요합니다"; exit 1; }
[ -x "$OVPN_BIN" ] || { errm "openvpn 바이너리 없음: $OVPN_BIN (NAVER Cloud SSL VPN 앱 설치 필요)"; exit 1; }

# --- 1) 키체인에서 비밀번호 ---
PASS="$(security find-generic-password -s "$KC_SERVICE" -a "$VPN_USER" -w 2>/dev/null || true)"
if [ -z "$PASS" ]; then
  errm "키체인에 비밀번호가 없습니다 ($KC_SERVICE / $VPN_USER)."
  printf '   %s'\''make setup'\'' 또는: security add-generic-password -U -s %s -a %s -w%s\n' "$C_DIM" "$KC_SERVICE" "$VPN_USER" "$C_RESET"
  exit 1
fi

# --- MAC 목록 (설정 override 없으면 자동탐지) ---
if [ -z "${MAC_JSON:-}" ]; then
  MAC_JSON="$(ifconfig 2>/dev/null | awk '$1=="ether"{gsub(":","-",$2); print toupper($2)}' \
              | awk '!seen[$0]++' | head -4 | jq -R . | jq -cs .)"
  [ -z "$MAC_JSON" ] && MAC_JSON='[]'
fi
OSVER="$(sw_vers -productVersion)-$(sw_vers -buildVersion)"

ftop "NAVER Cloud SSL VPN 연결"

# --- 2) authstate: 비번 검증 + OTP 문자 발송 + 프로필 수신 ---
line "🔐 로그인 요청 중…  $(dim '휴대폰으로 OTP 문자 발송')"
BODY="$(jq -nc --arg u "$VPN_USER" --arg p "$PASS" --arg f "$OVPN_NAME" \
  --arg cv "$CLIENT_VERSION" --arg ov "$OSVER" --argjson mac "$MAC_JSON" \
  '{user_id:$u, passwd:$p, type:"connect", ovpn_file_name:$f,
    client_version:$cv, os_name:"darwin", os_version:$ov, mac:$mac}')"
RESP="$(curl -s -m 20 -H 'Content-Type: application/json' -H 'Api-Version: 1' \
  -X POST "$DOMAIN/api/v3/authstate" --data-binary "$BODY")"
if [ "$(jq -r '.success' <<<"$RESP")" != "true" ]; then
  line "❌ 로그인 실패: $(jq -r '.err_msg // "아이디/비밀번호를 확인하세요"' <<<"$RESP")"
  fbot; exit 1
fi

# 프로필 저장
PBODY="$(jq -r '.profile_body // ""' <<<"$RESP")"
PNAME="$(jq -r --arg d "$OVPN_NAME" '.profile_name // $d' <<<"$RESP")"
mkdir -p "$DATADIR/profiles"
[ -n "$PBODY" ] && base64 -d <<<"$PBODY" > "$DATADIR/profiles/$PNAME"
STATE="$(jq -r '.state // ""' <<<"$RESP")"
line "✅ 비번 확인 · 프로필 수신  $(dim "$PNAME")"

# --- 3) OTP 입력 (state 가 있으면 OTP 필요) ---
OTP="${1:-}"
if [ -n "$STATE" ] && [ -z "$OTP" ]; then
  printf -v _otp_p '%s│%s  📱 %s문자로 받은 OTP 입력%s: ' "$C_DIM" "$C_RESET" "$C_BOLD" "$C_RESET"
  read -r -p "$_otp_p" OTP
fi

# --- 4) 임시 인증파일 (아이디 + OTP), 종료 시 삭제 ---
AUTH="$(mktemp /tmp/naver-vpn-auth.XXXXXX)"; chmod 600 "$AUTH"
trap 'rm -f "$AUTH"' EXIT
printf '%s\n%s\n' "$VPN_USER" "$OTP" > "$AUTH"

# --- 5) openvpn 실행: root 래퍼(NOPASSWD) 있으면 비번 없이, 없으면 GUI 폴백 ---
# 연결 전 터널 IP 스냅샷 — 이번 연결로 '새로' 뜬 IP 만 성공으로 인정(기존 다른 VPN 오탐 방지).
IPS_BEFORE="$(tunnel_ips | sort -u)"
line "🔌 VPN 연결 중…"
if [ -x "$WRAPPER" ]; then
  sudo "$WRAPPER" "$PNAME" "$AUTH" || true
else
  osascript <<APPLESCRIPT || true
do shell script "pkill -f 'vpn/openvpn' 2>/dev/null; sleep 1; '$OVPN_BIN' --config '$DATADIR/profiles/$PNAME' --auth-user-pass '$AUTH' --auth-nocache --daemon --log '$LOG'" with administrator privileges
APPLESCRIPT
fi
sleep 2

# --- 6) 연결 확인 ---
# 성공 판정은 '새 터널 IP 할당'을 1순위로 본다. openvpn 로그는 root 소유(0600)라
# 일반 사용자가 못 읽는 경우가 있어(권한 오류가 조용히 무시됨) 로그 grep 만으로는
# 실제 연결도 실패로 오판한다. 터널 IP 감지는 root 권한이 필요 없다.
line "⏳ 연결 확인 중…"
ok=0; IP=""
# 로그를 못 읽으면(root 소유 0600 등) 성공 후 안내만 한다 — 판정 자체는 새 터널 IP 가 1순위.
LOGREAD=1; [ -r "$LOG" ] || LOGREAD=0
for _ in $(seq 1 30); do
  # 이번 연결로 새로 뜬 사설 터널 IP
  IP="$(comm -13 <(printf '%s\n' "$IPS_BEFORE") <(tunnel_ips | sort -u) 2>/dev/null | head -1)"
  [ -n "$IP" ] && { ok=1; break; }
  grep -q "Initialization Sequence Completed" "$LOG" 2>/dev/null && { ok=1; break; }
  # 사용자가 TARGET 을 지정했다면 그 IP 도달도 성공으로 인정
  [ -n "$TARGET" ] && ping -c1 -t2 "$TARGET" >/dev/null 2>&1 && { ok=1; break; }
  sleep 1
done
if [ "$ok" != 1 ]; then
  line "❌ 연결 실패  $(dim "로그: $LOG")"
  fbot
  cat "$LOG" 2>/dev/null | tail -25 || sudo tail -25 "$LOG" 2>/dev/null || \
    printf '   %s로그를 읽을 수 없습니다(root 소유). 확인: sudo tail -25 "%s"%s\n' "$C_DIM" "$LOG" "$C_RESET"
  exit 1
fi

[ -z "$IP" ] && IP="$(tunnel_ip)"; GW="$(tunnel_gw "$IP")"
[ "$LOGREAD" = 0 ] && line "⚠️  로그 읽기 불가 $(dim "($LOG — root 소유. 'make install' 로 래퍼를 갱신하면 해결)")"
if [ -n "$IP" ]; then line "✅ 연결 완료 — $C_GREEN$C_BOLD${IP}$C_RESET $(dim '(터널 IP 할당)')"
else line "✅ 연결 완료"; fi

# --- 7) keepalive 시작 (유휴 끊김 방지) ---
if [ "${KEEPALIVE:-1}" != "0" ]; then
  KA="$(dirname "$0")/naver-vpn-keepalive"
  [ -x "$KA" ] || KA="naver-vpn-keepalive"
  if command -v "$KA" >/dev/null 2>&1 && "$KA" start >/dev/null 2>&1; then
    KHSHOW="${KEEPALIVE_HOST:-${GW:-자동}}"
    line "🔁 keepalive 시작  $(dim "${KEEPALIVE_INTERVAL:-60}s → $KHSHOW")"
  fi
fi
fbot; exit 0
